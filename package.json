{
  "name": "appgpp",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:lan": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build",
    "db:deploy": "prisma migrate deploy",
    "installer:clean": "powershell -ExecutionPolicy Bypass -Command \"Remove-Item 'dist/AppGPP-Installer-*.exe','dist/AppGPP-Installer.exe','dist/AppGPP-Payload*.zip','dist/Instalador APPGPP*.zip','dist/~AppGPP-Installer-*.DDF' -Force -ErrorAction SilentlyContinue\"",
    "installer:payload": "powershell -ExecutionPolicy Bypass -Command \"$r=$env:INIT_CWD; if ([string]::IsNullOrWhiteSpace($r)) { $r=(Get-Location).Path }; & (Join-Path $r 'installer/Build-Payload.ps1')\"",
    "installer:bundle": "powershell -ExecutionPolicy Bypass -Command \"$r=$env:INIT_CWD; if ([string]::IsNullOrWhiteSpace($r)) { $r=(Get-Location).Path }; & (Join-Path $r 'installer/Build-Installer.ps1')\"",
    "installer:iexpress": "powershell -ExecutionPolicy Bypass -Command \"$r=$env:INIT_CWD; if ([string]::IsNullOrWhiteSpace($r)) { $r=(Get-Location).Path }; & (Join-Path $r 'installer/Build-Installer.ps1')\"",
    "installer:ps2exe": "powershell -ExecutionPolicy Bypass -Command \"$r=$env:INIT_CWD; if ([string]::IsNullOrWhiteSpace($r)) { $r=(Get-Location).Path }; $pv=(Get-Content -LiteralPath (Join-Path $r 'package.json') -Raw | ConvertFrom-Json).version; $ts=Get-Date -Format 'yyyy.MM.dd.HHmm'; $v=$pv + '-' + $ts; . (Join-Path $r 'installer/tools/ps2exe.ps1'); Invoke-ps2exe -inputFile (Join-Path $r 'installer/Run-Installer.ps1') -outputFile (Join-Path $r ('dist/AppGPP-Installer-' + $v + '.exe')) -version $ts -noConsole -iconFile (Join-Path $r 'dist/AppGPP.ico')\"",
    "installer:build": "powershell -ExecutionPolicy Bypass -File installer/Build-Installer.ps1",
    "update:build": "powershell -ExecutionPolicy Bypass -File installer/Build-Update-Packages.ps1",
    "update:system": "powershell -ExecutionPolicy Bypass -File scripts/Update-AppGPP-System.ps1",
    "update:database": "powershell -ExecutionPolicy Bypass -File scripts/Update-AppGPP-Database.ps1",
    "update:both": "powershell -ExecutionPolicy Bypass -File scripts/Update-AppGPP-Both.ps1",
    "launcher:build": "powershell -ExecutionPolicy Bypass -Command \"$r=$env:INIT_CWD; if ([string]::IsNullOrWhiteSpace($r)) { $r=(Get-Location).Path }; $v=Get-Date -Format 'yyyy.MM.dd.HHmm'; . (Join-Path $r 'installer/tools/ps2exe.ps1'); Invoke-ps2exe -inputFile (Join-Path $r 'AppGPP-Start.ps1') -outputFile (Join-Path $r 'AppGPP-Start.exe') -version $v -noConsole -iconFile (Join-Path $r 'dist/AppGPP.ico')\"",
    "backup:sql": "node scripts/generate-backup-sql.js",
    "start": "node .next/standalone/server.js",
    "start:lan": "set HOSTNAME=0.0.0.0&& set PORT=3000&& node .next/standalone/server.js",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.525.0",
    "mysql2": "^3.14.3",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^23.0.0",
    "react": "19.1.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "19.1.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
