// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tbUser {
  id             String          @id @default(uuid())
  idUser         String?         @unique
  nomeUser       String?
  emailUser      String?         @unique
  emailVerified  DateTime?
  senhaUser      String?
  avatarUser     String?
  authTypeUser   String?
  formulariosUser Json?
  centrosUser    Json?
  statusUser     String          @default("ATIVO")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tbFuncioanrio  tbFuncionario[]
  transferenciasCustoPatrimonio tbTransferenciaCustoPatrimonio[]
  transferenciaProcessos tbTransferenciaProcesso[]
  transferenciasAlocacao tbTransferenciaAlocacao[]
  tbBmMedicao tbBmMedicao[]
  tbInventarioProcesso tbInventarioProcesso[]
  tbAuditoriaDevolucaoPatrimonio tbAuditoriaDevolucaoPatrimonio[]
  tbAtivoRedeTransferencia tbTransferenciaAtivoRede[]
  tbAtivoRedeDevolucao tbDevolucaoAtivoRede[]
}

model tbFuncionario {
  idF         String       @id @default(uuid())
  idMatFun    String       @unique
  nomeFun     String
  cpfFun      String?
  dataAdmFun  DateTime?
  dataDesFun  DateTime?
  avatarFun   String?
  idFuncaoFun String?
  idUserFun   String?
  idStatusFun String?
  idCustoFun  String?
  tbStatusFun tbStatusFun? @relation(fields: [idStatusFun], references: [idStatusFun])
  tbUser      tbUser?      @relation(fields: [idUserFun], references: [id])
  tbFuncao    tbFuncao?    @relation(fields: [idFuncaoFun], references: [idFuncao])
  tbCCusto    tbCCusto?    @relation(fields: [idCustoFun], references: [idCCusto])
  tbCadastro  tbCadastro[]
  tbHasLicencaFuncionario tbHasLicencaFuncionario[]
  tbTransferenciaAlocacaoOrigem tbTransferenciaAlocacao[] @relation("TransferenciaAlocacaoOrigem")
  tbTransferenciaAlocacaoDestino tbTransferenciaAlocacao[] @relation("TransferenciaAlocacaoDestino")
}

model tbLicenca {
  idLic        String       @id @default(uuid())
  descricaoLic String
  tbHasLicencaFuncionario tbHasLicencaFuncionario[]
}

model tbHasLicencaFuncionario {
  idHas         String        @id @default(uuid()) @map("id_has")
  idFunc        String        @map("idfunc")
  idLinc        String        @map("idLinc")
  dataInicio    DateTime      @map("datainicio")
  dataVencimetno DateTime     @map("datavencimetno")
  tbFuncionario tbFuncionario @relation(fields: [idFunc], references: [idF], onDelete: Cascade)
  tbLicenca     tbLicenca     @relation(fields: [idLinc], references: [idLic], onDelete: Cascade)

  @@unique([idFunc, idLinc])
  @@index([idFunc])
  @@index([idLinc])
  @@map("has_")
}

model tbStatusFun {
  idStatusFun        String          @id @default(uuid())
  descricaoStatusFun String
  tbFuncionario      tbFuncionario[]
}

model tbFuncao {
  idFuncao      String          @id @default(uuid())
  codigoFuncao  Int             @unique @default(autoincrement())
  nomeFuncao    String
  tbFuncionario tbFuncionario[]
}

model tbPatrimonio {
  idP                   String       @id @default(uuid())
  idPat                 String       @unique
  descricaoPat          String
  descricaoDetalhadaPat String?
  licencaPat            String?
  dataEntPat            DateTime
  dataSaiPat            DateTime?
  notaFiscalPat         String?
  valorPat              Float
  createdAt             DateTime?    @default(now())
  updatedAt             DateTime?    @updatedAt
  idPat_TipoPat         String?
  tbTipoPat             tbTipoPat?   @relation(fields: [idPat_TipoPat], references: [idTipPat])
  idPat_StatusPat       String?
  tbStatusPat           tbStatusPat? @relation(fields: [idPat_StatusPat], references: [idStatusPat])
  idPat_CustoPat        String?
  tbCCusto              tbCCusto?    @relation(fields: [idPat_CustoPat], references: [idCCusto])
  tbCadastro            tbCadastro[]
  tbDevolucao           tbDevolucao[]
  tbPatrimonioHistorico tbPatrimonioHistorico[]
  tbTransferenciaCustoPatrimonio tbTransferenciaCustoPatrimonio[]
  tbTransferenciaAlocacao tbTransferenciaAlocacao[]
  tbAuditoriaDevolucaoPatrimonio tbAuditoriaDevolucaoPatrimonio[]
}

model tbTipoPat {
  idTipPat        String         @id @default(uuid())
  descricaoTipPat String?
  tbPatrimonio    tbPatrimonio[]
  tbPatrimonioHistorico tbPatrimonioHistorico[]
}

model tbStatusPat {
  idStatusPat      String         @id @default(uuid())
  descricaoStatPat String
  tbPatrimonio     tbPatrimonio[]
  tbCadastro tbCadastro[]
  tbPatrimonioHistorico tbPatrimonioHistorico[]
}

model tbEmpresa {
  idEmp           String     @id @default(uuid())
  razaoEmpresa    String?
  fantasiaEmpresa String?
  cnpjEmpresa     String?
  idCustEmp       String?
  tbCCusto        tbCCusto[]
}

model tbStatusCCusto {
  idStatusCCusto        String    @id @default(uuid())
  descricaoStatusCCusto String    @unique
  tbCCusto              tbCCusto[]
}

model tbCCusto {
  idCCusto        String          @id @default(uuid())
  codigoCCusto    String?
  descricaoCCusto String?
  idEmp_Custo     String?
  idStatusCCusto   String?
  tbEmpresa       tbEmpresa?      @relation(fields: [idEmp_Custo], references: [idEmp])
  tbStatusCCusto  tbStatusCCusto? @relation(fields: [idStatusCCusto], references: [idStatusCCusto])
  tbPatrimonio    tbPatrimonio[]
  tbFuncionario   tbFuncionario[]
  tbPatrimonioHistorico tbPatrimonioHistorico[]
  transferenciasOrigem tbTransferenciaCustoPatrimonio[] @relation("TransferenciaOrigem")
  transferenciasDestino tbTransferenciaCustoPatrimonio[] @relation("TransferenciaDestino")
  tbBmMedicao tbBmMedicao[]
  tbInventarioProcesso tbInventarioProcesso[]
  tbAtivoRede    tbAtivoRede[]

  @@index([idStatusCCusto], map: "idx_ccusto_status_fk")
}

model tbBmMedicao {
  idBm                   String   @id @default(uuid())
  codigoBm               String   @unique
  idCCusto               String
  codigoCCusto           String?
  descricaoCCusto        String?
  mesBm                  Int
  anoBm                  Int
  contadorBm             Int
  statusBm               String   @default("ABERTO")
  dataInicioMedicao      DateTime
  dataFimMedicao         DateTime
  resumoJson             Json?
  resultadosJson         Json?
  naoInformadosJson      Json?
  gerouRelatorioExcel    Boolean  @default(false)
  gerouRelatorioPdf      Boolean  @default(false)
  idUserGeracao          String?
  fechadoAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tbCCusto               tbCCusto @relation(fields: [idCCusto], references: [idCCusto], onDelete: Cascade)
  tbUser                 tbUser?  @relation(fields: [idUserGeracao], references: [id], onDelete: SetNull)

  @@index([idCCusto, statusBm], map: "idx_bm_ccusto_status")
  @@index([idCCusto, anoBm, mesBm, contadorBm], map: "idx_bm_ccusto_comp")
  @@index([createdAt], map: "idx_bm_created_at")
}

model tbInventarioProcesso {
  idInventarioProcesso   String   @id @default(uuid())
  codigoInventario       String   @unique
  idCCusto               String?
  codigoCCusto           String?
  descricaoCCusto        String?
  mesInventario          Int
  anoInventario          Int
  contadorInventario     Int
  statusInventario       String   @default("ABERTO")
  dataInventario         DateTime
  dataFechamento        DateTime?
  responsavelInventario  String?
  localInventario        String?
  observacaoInventario   String?
  resumoJson             Json?
  itensJson              Json?
  idUserInventario       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tbCCusto               tbCCusto? @relation(fields: [idCCusto], references: [idCCusto], onDelete: SetNull)
  tbUser                 tbUser?   @relation(fields: [idUserInventario], references: [id], onDelete: SetNull)

  @@index([idCCusto, statusInventario], map: "idx_inv_ccusto_status")
  @@index([anoInventario, mesInventario, contadorInventario], map: "idx_inv_seq")
  @@index([createdAt], map: "idx_inv_created_at")
}

model tbTransferenciaCustoPatrimonio {
  idTransferencia        String      @id @default(uuid())
  idPatrimonio           String
  idCustoOrigem          String?
  idCustoDestino         String
  valorTransferido       Float?
  observacao             String?
  idUserTransferencia    String?
  idTransferenciaProcesso String?
  dataTransferencia      DateTime    @default(now())
  createdAt              DateTime    @default(now())

  tbPatrimonio           tbPatrimonio @relation(fields: [idPatrimonio], references: [idP], onDelete: Cascade)
  custoOrigem            tbCCusto?    @relation("TransferenciaOrigem", fields: [idCustoOrigem], references: [idCCusto])
  custoDestino           tbCCusto     @relation("TransferenciaDestino", fields: [idCustoDestino], references: [idCCusto])
  tbUser                 tbUser?      @relation(fields: [idUserTransferencia], references: [id])
  tbTransferenciaProcesso tbTransferenciaProcesso? @relation(fields: [idTransferenciaProcesso], references: [idTransferenciaProcesso], onDelete: SetNull)

  @@index([idPatrimonio, dataTransferencia], map: "idx_transf_pat_data")
  @@index([idCustoOrigem], map: "idx_transf_origem")
  @@index([idCustoDestino], map: "idx_transf_destino")
  @@index([idUserTransferencia], map: "idx_transf_user")
  @@index([idTransferenciaProcesso], map: "idx_transf_processo")
}

model tbTransferenciaProcesso {
  idTransferenciaProcesso String   @id @default(uuid())
  codigoTransferencia     String   @unique
  mesTransferencia        Int
  anoTransferencia        Int
  contadorTransferencia   Int
  statusTransferencia     String   @default("ABERTO")
  dataInicioTransferencia  DateTime @default(now())
  dataFechamento          DateTime?
  idUserCriacao           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tbUser                  tbUser?  @relation(fields: [idUserCriacao], references: [id], onDelete: SetNull)
  tbTransferenciaCustoPatrimonio tbTransferenciaCustoPatrimonio[]

  @@index([anoTransferencia, mesTransferencia, contadorTransferencia], map: "idx_transf_seq")
  @@index([statusTransferencia], map: "idx_transf_status")
}

model tbCadastro {
  idCad         String         @id @default(uuid())
  dataCadPat    DateTime?
  dataDevPat    DateTime?
  createdAt     DateTime?      @default(now())
  updatedAt     DateTime?      @updatedAt
  idPatCad      String?
  tbPatrimonio  tbPatrimonio?  @relation(fields: [idPatCad], references: [idPat])
  idMatFunCad   String?
  tbFuncionario tbFuncionario? @relation(fields: [idMatFunCad], references: [idMatFun])
  idStatusPatCad String
  tbStatusPat tbStatusPat? @relation(fields: [idStatusPatCad], references: [idStatusPat])
  tbDevolucao tbDevolucao[]
  tbTransferenciaAlocacao tbTransferenciaAlocacao[]
}

model tbTransferenciaAlocacao {
  idTransferenciaAlocacao String        @id @default(uuid())
  idCadastro              String
  idPatrimonio            String
  idMatriculaFuncionario  String?
  idMatriculaFuncionarioDestino String?
  statusAnterior          String?
  statusNovo              String
  observacao              String?
  idUserTransferencia     String?
  dataTransferencia       DateTime      @default(now())
  createdAt               DateTime      @default(now())

  tbCadastro              tbCadastro    @relation(fields: [idCadastro], references: [idCad], onDelete: Cascade)
  tbPatrimonio            tbPatrimonio  @relation(fields: [idPatrimonio], references: [idPat], onDelete: Cascade)
  tbFuncionario           tbFuncionario? @relation("TransferenciaAlocacaoOrigem", fields: [idMatriculaFuncionario], references: [idMatFun], onDelete: SetNull)
  tbFuncionarioDestino    tbFuncionario? @relation("TransferenciaAlocacaoDestino", fields: [idMatriculaFuncionarioDestino], references: [idMatFun], onDelete: SetNull)
  tbUser                  tbUser?       @relation(fields: [idUserTransferencia], references: [id], onDelete: SetNull)

  @@index([idCadastro, dataTransferencia], map: "idx_transf_aloc_cadastro_data")
  @@index([idPatrimonio], map: "idx_transf_aloc_patrimonio")
  @@index([idMatriculaFuncionario], map: "idx_transf_aloc_func")
  @@index([idMatriculaFuncionarioDestino], map: "idx_transf_aloc_func_destino")
  @@index([idUserTransferencia], map: "idx_transf_aloc_user")
}

model tbDevolucao {
  idDevolucao         String        @id @default(uuid())
  idDevolucaoProcesso String
  idPatrimonio        String
  idCadastro          String?
  dataInicioDevolucao DateTime
  dataFimDevolucao    DateTime?
  dataSaidaFornecedor DateTime?
  dataChegadaFornecedor DateTime?
  motivoDevolucao     String?
  notaFiscalDevolucao String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tbPatrimonio        tbPatrimonio  @relation(fields: [idPatrimonio], references: [idP], onDelete: Cascade)
  tbCadastro          tbCadastro?   @relation(fields: [idCadastro], references: [idCad], onDelete: SetNull)
  tbDevolucaoProcesso tbDevolucaoProcesso @relation(fields: [idDevolucaoProcesso], references: [idDevolucaoProcesso], onDelete: Restrict)

  @@index([idPatrimonio, dataInicioDevolucao], map: "idx_devolucao_pat_inicio")
  @@index([idCadastro], map: "idx_devolucao_cadastro")
  @@index([idDevolucaoProcesso], map: "idx_devolucao_processo_fk")
}

model tbDevolucaoProcesso {
  idDevolucaoProcesso String   @id @default(uuid())
  codigoDevolucao     String   @unique
  mesDevolucao        Int
  anoDevolucao        Int
  contadorDevolucao   Int
  statusDevolucao     String   @default("ABERTO")
  dataInicio          DateTime @default(now())
  dataFechamento      DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  tbDevolucao         tbDevolucao[]

  @@index([anoDevolucao, mesDevolucao, contadorDevolucao], map: "idx_dev_processo_seq")
  @@index([statusDevolucao], map: "idx_dev_processo_status")
}

model tbAuditoriaDevolucaoPatrimonio {
  idAuditoria          String   @id @default(uuid())
  idPatrimonioRef      String
  idPat                String
  statusAnterior       String?
  statusNovo           String?
  limpezaSolicitada    Boolean  @default(false)
  registrosRemovidos   Int      @default(0)
  idUserAcao           String?
  emailUserAcao        String?
  observacao           String?
  detalhesJson         Json?
  createdAt            DateTime @default(now())

  tbPatrimonio         tbPatrimonio @relation(fields: [idPatrimonioRef], references: [idP], onDelete: Cascade)
  tbUser               tbUser?      @relation(fields: [idUserAcao], references: [id], onDelete: SetNull)

  @@index([idPatrimonioRef, createdAt], map: "idx_aud_dev_pat_data")
  @@index([idPat], map: "idx_aud_dev_idpat")
  @@index([idUserAcao], map: "idx_aud_dev_user")
}

model tbPatrimonioHistorico {
  idHistorico            String      @id @default(uuid())
  idPatrimonioOriginal   String
  idPat                  String
  descricaoPat           String
  valorPat               Float
  dataEntPat             DateTime
  dataSaiPat             DateTime?
  notaFiscalPat          String?
  idPat_TipoPat          String?
  idPat_StatusPat        String?
  idPat_CustoPat         String?
  dataDevolucao          DateTime?
  motivoDevolucao        String?
  notaFiscalDevolucao    String?
  createdAt              DateTime    @default(now())

  tbPatrimonio           tbPatrimonio @relation(fields: [idPatrimonioOriginal], references: [idP], onDelete: Cascade)
  tbTipoPat              tbTipoPat?   @relation(fields: [idPat_TipoPat], references: [idTipPat])
  tbStatusPat            tbStatusPat? @relation(fields: [idPat_StatusPat], references: [idStatusPat])
  tbCCusto               tbCCusto?    @relation(fields: [idPat_CustoPat], references: [idCCusto])

  @@index([idPatrimonioOriginal], map: "idx_hist_pat_original")
  @@index([createdAt], map: "idx_hist_created_at")
}

model tbAtivoRede {
  idAtivoRedePk            String   @id @default(uuid())
  codigoAtivoRede          String   @unique
  nomeAtivoRede            String
  tipoAtivoRede            String
  idTipoAtivoRede          String?
  fabricanteAtivoRede      String?
  modeloAtivoRede          String?
  serialAtivoRede          String?
  macAtivoRede             String?
  ipGerenciamentoAtivoRede String?
  hostnameAtivoRede        String?
  localInstalacaoAtivoRede String?
  rackAtivoRede            String?
  portaSwitchAtivoRede     String?
  fotoAtivoRede            String?  @db.LongText
  dataEntradaAtivoRede     DateTime
  dataInstalacaoAtivoRede  DateTime?
  statusAtivoRede          String   @default("ATIVO")
  idStatusAtivoRede        String?
  centroResponsavelAtivoRede String?
  idCCustoAtivoRede        String?
  observacaoAtivoRede      String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tbTipoAtivoRede          tbTipoAtivoRede? @relation(fields: [idTipoAtivoRede], references: [idTipoAtivoRede])
  tbStatusAtivoRede        tbStatusAtivoRede? @relation(fields: [idStatusAtivoRede], references: [idStatusAtivoRede])
  tbCCusto                 tbCCusto?        @relation(fields: [idCCustoAtivoRede], references: [idCCusto])
  tbTransferenciaAtivoRede tbTransferenciaAtivoRede[]
  tbDevolucaoAtivoRede     tbDevolucaoAtivoRede[]

  @@index([codigoAtivoRede], map: "idx_ativo_rede_codigo")
  @@index([tipoAtivoRede], map: "idx_ativo_rede_tipo")
  @@index([idTipoAtivoRede], map: "idx_ativo_rede_tipo_fk")
  @@index([statusAtivoRede], map: "idx_ativo_rede_status")
  @@index([idStatusAtivoRede], map: "idx_ativo_rede_status_fk")
  @@index([localInstalacaoAtivoRede], map: "idx_ativo_rede_local")
  @@index([idCCustoAtivoRede], map: "idx_ativo_rede_ccusto")
}

model tbTipoAtivoRede {
  idTipoAtivoRede   String       @id @default(uuid())
  descricaoTipoAtivoRede String   @unique
  ativoRede         tbAtivoRede[]
}

model tbStatusAtivoRede {
  idStatusAtivoRede   String       @id @default(uuid())
  descricaoStatusAtivoRede String   @unique
  ativoRede         tbAtivoRede[]
}

model tbTransferenciaAtivoRede {
  idTransferenciaAtivoRede String   @id @default(uuid())
  idAtivoRede              String
  localOrigemAtivoRede     String?
  localDestinoAtivoRede    String?
  centroOrigemAtivoRede    String?
  centroDestinoAtivoRede   String?
  statusAnteriorAtivoRede  String?
  statusNovoAtivoRede      String?
  observacao               String?
  idUserTransferencia      String?
  dataTransferencia        DateTime @default(now())
  createdAt                DateTime @default(now())

  tbAtivoRede              tbAtivoRede @relation(fields: [idAtivoRede], references: [idAtivoRedePk], onDelete: Cascade)
  tbUser                   tbUser?     @relation(fields: [idUserTransferencia], references: [id], onDelete: SetNull)

  @@index([idAtivoRede, dataTransferencia], map: "idx_transf_ativo_rede_data")
  @@index([idUserTransferencia], map: "idx_transf_ativo_rede_user")
}

model tbDevolucaoAtivoRede {
  idDevolucaoAtivoRede      String   @id @default(uuid())
  idAtivoRede               String
  dataInicioDevolucao       DateTime
  dataFimDevolucao          DateTime?
  motivoDevolucao           String?
  destinoDevolucao          String?
  notaFiscalDevolucao       String?
  observacao                String?
  idUserDevolucao           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tbAtivoRede               tbAtivoRede @relation(fields: [idAtivoRede], references: [idAtivoRedePk], onDelete: Cascade)
  tbUser                    tbUser?     @relation(fields: [idUserDevolucao], references: [id], onDelete: SetNull)

  @@index([idAtivoRede, dataInicioDevolucao], map: "idx_dev_ativo_rede_data")
  @@index([idUserDevolucao], map: "idx_dev_ativo_rede_user")
}

model Account {
  idAccont          String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  sesseion_state    String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime?

  @@unique([identifier, token])
  @@map("VerificationTokens")
}

model tbUnifiConfig {
  id           String   @id @default(uuid())
  type         String   @default("cloud")
  apiKey       String?
  host         String?
  publicUrl    String?
  identitySource String? @default("UNIFI")
  identitySourceNotes String?
  username     String?
  password     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}
