# Banco de dados (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-a-long-random-secret"

# URL publica usada pelo sistema para gerar links, login e baixar o agente
# Em producao, deixe igual a URL externa da aplicacao
APPGPP_PUBLIC_URL="https://app.seudominio.com"

# Login admin local
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="change-me"

# OAuth Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Chave para criptografia de segredos UniFi (32 bytes em base64 ou texto com 32 chars)
UNIFI_SECRET_KEY="change-me-32-bytes-secret-key!!!"

# API Key da UniFi, usada quando nao estiver salva no banco
UNIFI_API_KEY=""

# Token do agente local de inventario/monitoramento
HOST_INVENTORY_AGENT_TOKEN=""

# Token opcional para baixar o script/instalador do agente
HOST_INVENTORY_AGENT_DOWNLOAD_TOKEN=""

# Caminho opcional do navegador usado pelo Puppeteer
# Ex.: C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
PUPPETEER_EXECUTABLE_PATH=""

# Alternativas aceitas pelo helper de PDF
CHROME_PATH=""
GOOGLE_CHROME_BIN=""

# Next.js dev origins (opcional, separado por virgula)
DEV_ALLOWED_ORIGINS="localhost:3000,127.0.0.1:3000"

# Dashboard auto-refresh (ms)
# 30000 = 30s (padrao)
# 0 = desabilita auto-refresh
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=30000
